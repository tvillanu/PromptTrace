{
  "manifest_version": 3,
  "name": "PromptTrace",
  "version": "1.0.0",
  "description": "Captures, audits, and monitors prompts sent to AI chatbots.",
  "permissions": [
    "storage",
    "webRequest",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://*.bing.com/*",
    "https://www.bing.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://*.copilot.com/*",
        "https://*.bing.com/*",
        "https://www.bing.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "prompttrace16.png",
      "32": "prompttrace32.png",
      "48": "prompttrace48.png",
      "128": "prompttrace128.png"
    }
  },
  "icons": {
      "16": "prompttrace16.png",
      "32": "prompttrace32.png",
      "48": "prompttrace48.png",
      "128": "prompttrace128.png"
  }
}
